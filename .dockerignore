# Keeps secrets and local state out of every Docker build context (REVIEW-FIXES MAIN item 2).
# The images COPY named paths only; tests/unit/test_dockerignore.py pins that none of them is
# excluded here and that the secrets below are.

# Secrets and per-machine state
.env
.env.*
!.env.example
.lane
.ci-pass
.claude
*.tfstate
*.tfstate.*
tfplan
.terraform

# Version control and caches
.git
.venv
**/__pycache__
**/*.pyc
.mypy_cache
.ruff_cache
.pytest_cache

# Local data, runs and builds (the api image builds web/dist itself)
data
out
runs
eval/results
web/node_modules
web/dist
web/.astro
**/.DS_Store
