# Copy to .env and fill in. Never commit .env. Claude Code may read the names, never the values.

# --- Tier 0: the command line (reel make) ---
ANTHROPIC_API_KEY=            # key from the Claude Console workspace "reel-studio" (D59)
GEMINI_API_KEY=               # optional: without it "Keep the voice?" is forced off (D14)
FFMPEG_PATH=                  # Mac: /opt/homebrew/opt/ffmpeg-full/bin/ffmpeg (keg-only, zscale); image: /usr/bin/ffmpeg
FFPROBE_PATH=                 # Mac: /opt/homebrew/opt/ffmpeg-full/bin/ffprobe; image: /usr/bin/ffprobe

# --- Tier 1: the website on your laptop ---
PAYMENTS=off                  # off | stripe
STRIPE_SECRET_KEY=            # test mode key (sk_test_...), only with PAYMENTS=stripe
STRIPE_WEBHOOK_SECRET=        # written by `make stripe-listen` (never typed or printed)
STRIPE_PRICE_ID=              # the €19 price (price_...): `make stripe-laptop` writes it, STRIPE_COUPON_ID and PAYMENTS, only with PAYMENTS=stripe
STRIPE_COUPON_ID=             # the 100%-off coupon `reelctl codes create` attaches codes to, only with PAYMENTS=stripe
SITE_URL=http://localhost:8080
MAIL_FROM=Reel Studio <reels@localhost>
KEVIN_ALERT_EMAIL=            # where failure and pause alerts go
GA4_MEASUREMENT_ID=           # empty = analytics off (D75)
GOOGLE_ADS_ID=                # empty = ads tag off (D75)
TIER=laptop                   # laptop | cloud: which adapters to build; Terraform sets cloud on Cloud Run
FIRESTORE_PROJECT=reel-studio-local   # the emulator's project id; the client finds it via FIRESTORE_EMULATOR_HOST (F308)
SMTP_HOST=mailpit             # Mailpit in compose (F309)
SMTP_PORT=1025
DATA_DIR=./data               # filesystem Storage root on the host; compose sets its own (/app/data)
ORDER_ID=                     # reel-editor job only: set per execution by the launcher, never here
RUN_TOKEN=                    # reel-editor job only: set per execution by the launcher, never here
GCS_BUCKET=                   # TIER=cloud only: the media bucket (Terraform sets it)
EDITOR_JOB=                   # TIER=cloud only: projects/<project>/locations/<region>/jobs/reel-editor
RESEND_SENDING_KEY=           # TIER=cloud only: the sending-only key `make dns` creates (Secret Manager)
WEB_DIST=./web/dist           # the Astro build the API serves
VOICE_AVAILABLE=false         # true only where the dispatcher has GEMINI_API_KEY (D14, D62)

# --- Build steps --- (absolute paths: .env is not a shell, $HOME is not expanded)
OLD_KIT_DIR=                  # first-run.sh fills it: /Users/<you>/projects/opus-build-day-make-reels
REEL_FIXTURES_DIR=            # first-run.sh fills it: /Users/<you>/projects/reel-studio/input

# --- Tier 2: Google Cloud (STEP-08) ---
GCP_PROJECT=
GCP_REGION=europe-west1       # D50
GCP_BILLING_ACCOUNT=
CLOUD_ANTHROPIC_API_KEY=      # a second key in workspace reel-studio, for the cloud only
CLOUD_GEMINI_API_KEY=         # from a billing-enabled Google project, for the cloud only
RESEND_API_KEY=               # full access, laptop only, used by `make dns`; the cloud gets a sending-only key
CLOUDFLARE_API_TOKEN=         # Zone DNS Edit on limeralda.com only
EMAIL_DOMAIN=reels.limeralda.com   # D56
